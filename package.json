{
  "name": "ytm-player-server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix client",
    "typecheck": "tsc --noEmit",
    "start": "tsx server.ts",
    "server": "tsx watch server.ts",
    "client": "npm run start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "remote-codex": "tsx tools/remote-codex/watch.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirce/ytm-player.git"
  },
  "bugs": {
    "url": "https://github.com/xirce/ytm-player/issues"
  },
  "homepage": "https://github.com/xirce/ytm-player#readme",
  "dependencies": {
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "prom-client": "^15.1.3",
    "undici": "^8.10.0",
    "youtubei.js": "^18.0.0",
    "ytcog": "^2.5.5",
    "ytmusic-advanced": "^2.1.0",
    "ytmusic-api": "^5.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "concurrently": "^10.0.5",
    "morgan": "^1.11.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
