YOUTUBE_PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416
PO_TOKEN_PROVIDER_IMAGE=brainicism/bgutil-ytdlp-pot-provider@sha256:9a96e6385ce1928da87dea07b1cab0413d2cf8c07a3b8a8bd419f53df2c3843c
YOUTUBE_CACHE_DIR=.cache/youtubei
DATABASE_URL=postgres://ytm:change-me@localhost:5433/ytm
# Local Docker database settings. Keep DATABASE_URL in sync when overriding them.
POSTGRES_DB=ytm
POSTGRES_USER=ytm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes encoded as base64 or 64 hexadecimal characters.
YOUTUBE_CREDENTIALS_ENCRYPTION_KEY=

# Address and port exposed by the unified production server.
HOST=0.0.0.0
PORT=3001

# Optional Remote Codex settings. Generate a long random token before exposing
# this service outside localhost. If omitted, a token is generated in .cache.
REMOTE_CODEX_HOST=0.0.0.0
REMOTE_CODEX_PORT=3210
REMOTE_CODEX_TOKEN=
REMOTE_CODEX_EXECUTABLE=
