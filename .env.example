YOUTUBE_PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416
YOUTUBE_CACHE_DIR=.cache/youtubei
# Cookie header copied from an authenticated request to music.youtube.com.
# Keep this value private; it grants access to your YouTube account.
YOUTUBE_MUSIC_COOKIE=
# Value of the X-Goog-AuthUser header (0 for the first signed-in Google account).
YOUTUBE_MUSIC_AUTHUSER=0

# Address and port exposed by the unified production server.
HOST=0.0.0.0
PORT=3001
# Optional X-Goog-PageId header, required for some Brand Account channels.
YOUTUBE_MUSIC_PAGE_ID=
# Language used by YouTube Music for section titles and metadata.
YOUTUBE_MUSIC_LANGUAGE=ru
