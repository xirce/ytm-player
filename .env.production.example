APP_DOMAIN=music.example.com
APP_BASE_URL=https://music.example.com
APP_IMAGE=ytm-player:local

POSTGRES_DB=ytm
POSTGRES_USER=ytm
POSTGRES_PASSWORD=replace-with-a-long-random-password
